# ==============================================================================
# EVENTRA — Production Environment Configuration Reference
# ==============================================================================
# This template documents all environment variables required for deploying
# EVENTRA to production (Frontend on Vercel, Backend on Render/Railway, Database on Neon).
# ==============================================================================

# ==============================================================================
# 1. BACKEND API SERVICE (Render / Railway / Container)
# ==============================================================================
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1

# Frontend Origin(s) for CORS and Authentication
# Set to your live production frontend URL (and custom domain if applicable, comma-separated)
FRONTEND_URL=https://eventra-lxtc0uqsr-meiyarasanmeiyarasan3-7028s-projects.vercel.app

# Cookie Domain (Leave blank or omit for host-only cookies across different domains)
COOKIE_DOMAIN=

# PostgreSQL Database (Neon serverless connection strings)
# DATABASE_URL: Neon pooled connection string (port 5432 with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL: Neon direct connection string (used for migrations and schema push)
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets (Generate secure random 32+ character strings)
JWT_SECRET=production_jwt_secret_min_32_characters_random_hex_string_here
JWT_REFRESH_SECRET=production_refresh_jwt_secret_min_32_characters_random_hex_string_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Default Initial Administrator Seed (Created during database seeding)
ADMIN_NAME=Admin Eventra
ADMIN_EMAIL=admin@eventra.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Default Demo Organizer Seed
ORGANIZER_NAME=Sarah Organizer
ORGANIZER_EMAIL=organizer@eventra.com
ORGANIZER_PASSWORD=YourStrongOrganizerPassword123!

# Default Demo Attendee Seed
ATTENDEE_NAME=Alex Attendee
ATTENDEE_EMAIL=attendee@eventra.com
ATTENDEE_PASSWORD=YourStrongAttendeePassword123!

# Google Gemini AI Integration (Required for AI description, natural search & chat)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Cloudinary Storage for Event Posters (Optional - fallbacks used if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Optional - in-memory logger simulation used if omitted)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@yourdomain.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

# ==============================================================================
# 2. FRONTEND WEB APPLICATION (Vercel / Netlify)
# ==============================================================================
# NEXT_PUBLIC_API_URL: Public URL to your deployed backend API with /api/v1 prefix
NEXT_PUBLIC_API_URL=https://eventra-api.onrender.com/api/v1

# NEXT_PUBLIC_APP_URL: Public URL of your deployed frontend web application
NEXT_PUBLIC_APP_URL=https://eventra-lxtc0uqsr-meiyarasanmeiyarasan3-7028s-projects.vercel.app

