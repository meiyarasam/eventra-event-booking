{
  "name": "eventra",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Quality Event Discovery, Booking & Ticketing Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=packages/shared run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev": "npm run dev:api",
    "start:api": "npm --workspace=apps/api run start",
    "start:web": "npm --workspace=apps/web run start",
    "start": "npm run start:api",
    "test": "npm --workspace=apps/api run test",
    "db:generate": "npm --workspace=apps/api run db:generate",
    "db:migrate": "npm --workspace=apps/api run db:migrate",
    "db:push": "npm --workspace=apps/api run db:push",
    "db:seed": "npm --workspace=apps/api run db:seed"
  },
  "keywords": [
    "event-booking",
    "ticketing",
    "nextjs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "EVENTRA Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
